# Database (Supabase PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://username:password@host:5432/astrologia"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_FULL_READING_PRICE_ID="price_..."      # $75 one-time
STRIPE_SUBSCRIPTION_PRICE_ID="price_..."      # $27/month

# Resend (transactional email)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="readings@yourdomain.com"

# App URL (production)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
